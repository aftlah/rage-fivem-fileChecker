{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAGE File Scanner",
  "version": "1.0.0",
  "identifier": "com.altaf.rage-file-checker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
        "windows": [
      {
        "label": "main",
        "title": "RAGE File Scanner",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Aftlah",
    "copyright": "Copyright © Aftlah",
    "shortDescription": "Read-only scanner for FiveM files",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
